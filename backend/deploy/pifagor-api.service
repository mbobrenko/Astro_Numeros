[Unit]
Description=Pifagor Square API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=pifagor
WorkingDirectory=/opt/pifagor/backend
EnvironmentFile=/opt/pifagor/backend/.env
ExecStart=/opt/pifagor/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
