# Copy to .env (or set as systemd Environment= lines) and fill in real values.
# Never commit the real .env to git — it's already in .gitignore.

# From @BotFather when you create the Telegram bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Any long random string — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Lava.top — active payment provider for both RU and EN audiences.
# Dashboard -> Integrations -> API for the key and the webhook key;
# Dashboard -> Products -> 4 products (one per pack size, per language) for
# the offerId values — see lava_assets/ for their cover/description/etc.
LAVA_API_KEY=lava_ExampleApiKeyReplaceMe
LAVA_WEBHOOK_SECRET=change-me-webhook-key
LAVA_OFFER_PACK3_RU=00000000-0000-0000-0000-000000000000
LAVA_OFFER_PACK3_EN=00000000-0000-0000-0000-000000000000
LAVA_OFFER_PACK10_RU=00000000-0000-0000-0000-000000000000
LAVA_OFFER_PACK10_EN=00000000-0000-0000-0000-000000000000

# The public URL of the site (used for CORS + Lava.top return URLs)
FRONTEND_URL=https://your-domain.example

# Where the SQLite file lives on the server
DB_PATH=/opt/pifagor/backend/app.db

# Dormant — only needed if YooKassa (/api/pay/yookassa/*) is switched back on
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=live_ExampleSecretReplaceMe
